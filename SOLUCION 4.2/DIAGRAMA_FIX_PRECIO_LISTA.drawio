    <!-- cargarPanelPreventiva NUEVO -->
    <mxCell id="met_new" value="&lt;b&gt;cargarPanelPreventiva() — NUEVO&lt;/b&gt;&lt;br/&gt;1. cargarTurnoPacientePreventiva() → precioLista lee de tep (puede ser 0)&lt;br/&gt;2. &lt;b&gt;SI precioLista == 0&lt;/b&gt;:&lt;br/&gt;   → toma IdSubtipo de la grilla (60E94892 - HIJO)&lt;br/&gt;   → llama ObtenerPrecioPublico(IdSubtipo, fecha)&lt;br/&gt;   → si PrecioLista &gt; 0 → lo asigna a la entidad&lt;br/&gt;3. llenarPanelPacientePreventiva()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="820" y="310" width="360" height="130" as="geometry" />
    </mxCell>

