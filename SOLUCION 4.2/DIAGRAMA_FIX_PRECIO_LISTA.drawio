    <!-- ===== SECCIÓN INFERIOR: CAUSA RAÍZ ===== -->
    <mxCell id="sec_root" value="🔍  CAUSA RAÍZ — Por qué TipoExamenDePaciente guarda el PADRE y no el HIJO" style="text;html=1;strokeColor=#7B68EE;fillColor=#ede7f6;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;fontColor=#4a148c;" vertex="1" parent="1">
      <mxGeometry x="40" y="660" width="1460" height="36" as="geometry" />
    </mxCell>

    <mxCell id="root1" value="&lt;b&gt;Árbol de Especialidades en BD&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;FUTBOL (PADRE) → Padre=true, IdPadre=NULL&lt;br/&gt;  └─ FUTBOL METRO (HIJO) → Padre=false, IdPadre=FUTBOL&lt;br/&gt;  └─ FUTBOL AFA (HIJO) → Padre=false, IdPadre=FUTBOL&lt;br/&gt;  └─ FUTBOL METRO SIN LAB (HIJO) → Padre=false, IdPadre=FUTBOL&lt;br/&gt;&lt;br/&gt;PrecioPublico SOLO tiene registros de los HIJOS (Padre=false)&lt;br/&gt;El PADRE nunca tiene precio en PrecioPublico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="40" y="720" width="420" height="160" as="geometry" />
    </mxCell>

    <mxCell id="root2" value="&lt;b&gt;¿Por qué TipoExamenDePaciente tiene el PADRE?&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Al asignar un turno NUEVO, nuevoTurnoPacientePreventiva() en&lt;br/&gt;CapaDatosMepryl/Turno.cs hace:&lt;br/&gt;&lt;br/&gt;  entidad.TipoExamen.Id = Horario.especialidadID  (= HIJO)&lt;br/&gt;&lt;br/&gt;Pero cargarEstudiosPorTipoExamen() en TipoExamen.cs resuelve&lt;br/&gt;el padre y guarda el PADRE como idEspecialidad en el sp.&lt;br/&gt;&lt;br/&gt;Resultado: precioLista no se guarda o queda en 0 en registros viejos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="500" y="720" width="420" height="160" as="geometry" />
    </mxCell>

    <mxCell id="root3" value="&lt;b&gt;La grilla SÍ tiene el HIJO correcto&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;cargarTurnos() en SQL hace JOIN con Horario → Especialidad&lt;br/&gt;y devuelve la columna IdSubtipo = especialidad HIJA (FUTBOL METRO).&lt;br/&gt;&lt;br/&gt;Por eso la grilla muestra correctamente 'FUTBOL METRO'&lt;br/&gt;y su IdSubtipo apunta al registro con precio en PrecioPublico.&lt;br/&gt;&lt;br/&gt;El fix usa este IdSubtipo de la grilla como fuente confiable&lt;br/&gt;para obtener PrecioLista cuando el guardado en BD es 0." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="960" y="720" width="420" height="160" as="geometry" />
    </mxCell>

    <!-- ===== CÓDIGO DEL FIX ===== -->
    <mxCell id="code_fix" value="&lt;b&gt;Código aplicado en cargarPanelPreventiva() y cargarPanelLaboral():&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;if (pacientePreventiva.TipoExamen.PrecioLista == 0)&lt;br/&gt;{&lt;br/&gt;    string idSubtipo = dgv.Rows[idx].Cells[&quot;IdSubtipo&quot;].Value?.ToString();&lt;br/&gt;    if (!string.IsNullOrEmpty(idSubtipo) &amp;amp;&amp;amp; idSubtipo != Guid.Empty.ToString())&lt;br/&gt;    {&lt;br/&gt;        DataTable pp = turno.ObtenerPrecioPublico(new Guid(idSubtipo), obtenerFecha());&lt;br/&gt;        if (pp.Rows.Count &gt; 0 &amp;amp;&amp;amp; Convert.ToDouble(pp.Rows[0][&quot;PrecioLista&quot;]) &gt; 0)&lt;br/&gt;            paciente.TipoExamen.PrecioLista = Convert.ToDouble(pp.Rows[0][&quot;PrecioLista&quot;]);&lt;br/&gt;    }&lt;br/&gt;}" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="40" y="910" width="760" height="200" as="geometry" />
    </mxCell>

    <mxCell id="impacto" value="&lt;b&gt;Impacto del fix:&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;✅ Turnos PREVENTIVA ya asignados → muestran PrecioLista correcto&lt;br/&gt;✅ Turnos LABORAL ya asignados → muestran PrecioLista correcto&lt;br/&gt;✅ Turnos nuevos que tenían 0 guardado en precioLista → se corrigen en pantalla&lt;br/&gt;✅ No modifica la BD (solo cambia el valor en memoria / pantalla)&lt;br/&gt;✅ Solo actúa cuando precioLista == 0 (no afecta turnos que ya tienen precio correcto)&lt;br/&gt;✅ Aplica sobre ambos paneles: panelPacientePreventiva y panelLaboral" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="840" y="910" width="640" height="200" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>
