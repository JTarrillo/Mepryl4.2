        <mxCell id="tep-antes" value="&lt;font size='1'&gt;&lt;code&gt;id uniqueidentifier PK&lt;br&gt;idConsulta uniqueidentifier&lt;br&gt;idTurno uniqueidentifier&lt;br&gt;modificado varchar(3)&lt;br&gt;idEspecialidad uniqueidentifier&lt;br&gt;&lt;b&gt;precioExamen decimal(18,2)&lt;/b&gt;&lt;br&gt;factClub varchar(1)&lt;br&gt;rm, imp, inf, mail...&lt;/code&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#F5F5F5;strokeColor=#999999;verticalAlign=middle;align=left;spacingLeft=10;fontSize=10;" vertex="1" parent="sec1">
          <mxGeometry x="30" y="65" width="250" height="165" as="geometry" />
        </mxCell>

