        <mxCell id="titulo" value="&lt;b&gt;MEPRYL 4.2 — Cambios Parte 3&lt;/b&gt;&lt;br&gt;PrecioLista en Turnos + Precios por Periodo (DB: periodo)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontSize=16;" vertex="1" parent="1">
