        <!-- Bug 1: ReadOnly -->
        <mxCell id="bug1-title" value="&lt;b&gt;Bug: tbPrecioLista ReadOnly&lt;/b&gt;" style="text;html=1;fontSize=11;fontColor=#C62828;align=left;" vertex="1" parent="sec3">
