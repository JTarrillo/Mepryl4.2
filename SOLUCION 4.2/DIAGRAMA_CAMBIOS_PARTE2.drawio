        <mxCell id="bug1-despues" value="&lt;font color='#2E7D32'&gt;✅ &lt;b&gt;AHORA:&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='1'&gt;Eliminado &lt;code&gt;ReadOnly = true&lt;/code&gt; del Designer&lt;br&gt;Agregado &lt;code&gt;tbPrecioLista.Enabled&lt;/code&gt; en&lt;br&gt;&lt;code&gt;cambiarHabilitacionControles()&lt;/code&gt;&lt;br&gt;Se habilita al Editar, se deshabilita al Cancelar/Guardar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sec3">
